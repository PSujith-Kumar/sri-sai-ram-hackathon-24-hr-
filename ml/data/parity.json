[{"text": "I woke up feeling really cheerful and had a nice breakfast", "mood": [0.0029, 0.0079, 0.0027, 0.9819, 0.0017, 0.0009, 0.0021], "severity": [0.0342, 0.9563, 0.0013, 0.0082]}, {"text": "My granddaughter drew me a picture, it made me smile", "mood": [0.008, 0.0051, 0.0119, 0.9256, 0.0162, 0.0275, 0.0057], "severity": [0.0106, 0.9672, 0.0128, 0.0095]}, {"text": "The nurse says I'm improving, what a relief", "mood": [0.0335, 0.1337, 0.0328, 0.4362, 0.0371, 0.3064, 0.0203], "severity": [0.0092, 0.9672, 0.013, 0.0106]}, {"text": "Feeling quite good this afternoon, thank you for asking", "mood": [0.0306, 0.0161, 0.0285, 0.7588, 0.0201, 0.1243, 0.0215], "severity": [0.0077, 0.959, 0.0029, 0.0305]}, {"text": "Could you remind me when to take the blue tablet", "mood": [0.0008, 0.0006, 0.0015, 0.0017, 0.0146, 0.9801, 0.0007], "severity": [0.0046, 0.9825, 0.001, 0.012]}, {"text": "What time does the doctor come", "mood": [0.0062, 0.0076, 0.0152, 0.0156, 0.0045, 0.9455, 0.0053], "severity": [0.0083, 0.9574, 0.0104, 0.0239]}, {"text": "Is my token close yet", "mood": [0.0245, 0.0312, 0.1243, 0.0472, 0.051, 0.6051, 0.1166], "severity": [0.035, 0.9082, 0.0118, 0.045]}, {"text": "Good morning, how are you", "mood": [0.0016, 0.0007, 0.0069, 0.0454, 0.0023, 0.9411, 0.002], "severity": [0.033, 0.9533, 0.0036, 0.01]}, {"text": "I already took my morning pills", "mood": [0.0146, 0.0166, 0.046, 0.0142, 0.0366, 0.8233, 0.0487], "severity": [0.1134, 0.7704, 0.0333, 0.083]}, {"text": "Where can I get a glass of water", "mood": [0.0048, 0.0014, 0.0094, 0.0048, 0.0086, 0.9678, 0.0032], "severity": [0.0281, 0.9361, 0.0223, 0.0135]}, {"text": "There is no chest pain, I only wanted to ask about lunch", "mood": [0.001, 0.0022, 0.0162, 0.0021, 0.0091, 0.9685, 0.0009], "severity": [0.3539, 0.6425, 0.0015, 0.0021]}, {"text": "The days here are long and I keep thinking about my home", "mood": [0.0035, 0.007, 0.0048, 0.0051, 0.963, 0.0147, 0.002], "severity": [0.2487, 0.7343, 0.0102, 0.0068]}, {"text": "Nobody visited me this week and it hurts", "mood": [0.2997, 0.0074, 0.0953, 0.1538, 0.3617, 0.0364, 0.0456], "severity": [0.0175, 0.8063, 0.0126, 0.1637]}, {"text": "I feel like I'm all alone in the world", "mood": [0.0048, 0.0314, 0.0093, 0.0087, 0.9326, 0.0059, 0.0074], "severity": [0.0359, 0.8484, 0.0043, 0.1114]}, {"text": "I've been feeling very down lately and I can't eat", "mood": [0.0189, 0.1079, 0.0871, 0.0192, 0.7103, 0.0019, 0.0547], "severity": [0.03, 0.5136, 0.1309, 0.3255]}, {"text": "I keep crying and have no interest in anything or any food", "mood": [0.0646, 0.0069, 0.0035, 0.0094, 0.7999, 0.1128, 0.0028], "severity": [0.0157, 0.9688, 0.0004, 0.0151]}, {"text": "What if the scan shows something serious, I can't stop thinking about it", "mood": [0.0033, 0.9644, 0.0131, 0.0026, 0.0036, 0.0125, 0.0005], "severity": [0.2263, 0.5328, 0.2045, 0.0364]}, {"text": "I am really nervous about the operation next week", "mood": [0.002, 0.9898, 0.0005, 0.0007, 0.0008, 0.0053, 0.0009], "severity": [0.0018, 0.9929, 0.0017, 0.0036]}, {"text": "My mind keeps racing with worry tonight", "mood": [0.0197, 0.8004, 0.0635, 0.0598, 0.0199, 0.017, 0.0197], "severity": [0.1203, 0.4708, 0.0601, 0.3487]}, {"text": "My hands are trembling and I feel jumpy", "mood": [0.0317, 0.5493, 0.0997, 0.1345, 0.0786, 0.0283, 0.0779], "severity": [0.0043, 0.021, 0.0027, 0.972]}, {"text": "I feel so drained today, I just want to sleep", "mood": [0.0001, 0.0002, 0.0002, 0.0003, 0.001, 0.0001, 0.998], "severity": [0.1062, 0.4441, 0.0187, 0.4309]}, {"text": "I have no strength left after that walk", "mood": [0.0902, 0.0856, 0.103, 0.0852, 0.0878, 0.2155, 0.3327], "severity": [0.0692, 0.9097, 0.006, 0.0151]}, {"text": "I feel faint and weak every time I stand up", "mood": [0.0545, 0.0115, 0.0265, 0.0122, 0.0107, 0.0134, 0.8712], "severity": [0.0647, 0.0632, 0.006, 0.866]}, {"text": "I hardly slept and now I feel awful and shaky", "mood": [0.01, 0.0373, 0.0296, 0.1634, 0.0103, 0.0159, 0.7336], "severity": [0.011, 0.3909, 0.0101, 0.588]}, {"text": "This is unacceptable, I have been waiting for hours", "mood": [0.4086, 0.0323, 0.0935, 0.0595, 0.0602, 0.3341, 0.0118], "severity": [0.02, 0.9116, 0.0486, 0.0199]}, {"text": "I'm furious that no one answered my call", "mood": [0.9745, 0.0049, 0.0076, 0.0016, 0.001, 0.0093, 0.0012], "severity": [0.007, 0.9468, 0.0418, 0.0044]}, {"text": "Stop bothering me, I'm sick of all this", "mood": [0.0045, 0.0112, 0.9531, 0.0015, 0.0127, 0.0162, 0.0008], "severity": [0.1219, 0.0173, 0.1495, 0.7114]}, {"text": "My lower back has been aching since yesterday", "mood": [0.0299, 0.0307, 0.6881, 0.0954, 0.0478, 0.0426, 0.0655], "severity": [0.0209, 0.0911, 0.0529, 0.8351]}, {"text": "I threw up after breakfast and feel unwell", "mood": [0.0224, 0.0353, 0.6521, 0.1643, 0.035, 0.0472, 0.0437], "severity": [0.0999, 0.1712, 0.0662, 0.6627]}, {"text": "There is a throbbing headache behind my eyes", "mood": [0.0039, 0.0056, 0.8999, 0.0053, 0.0062, 0.067, 0.0121], "severity": [0.0724, 0.1222, 0.041, 0.7645]}, {"text": "a deep cut has been bothering me for the past hour", "mood": [0.0053, 0.0059, 0.9466, 0.0077, 0.0131, 0.0136, 0.0078], "severity": [0.0196, 0.0053, 0.9537, 0.0214]}, {"text": "I feel cross", "mood": [0.9613, 0.0033, 0.0073, 0.0046, 0.0184, 0.0012, 0.0039], "severity": [0.009, 0.9167, 0.0049, 0.0694]}, {"text": "Listen, my mouth is twisted and my words come out jumbled", "mood": [0.0131, 0.0101, 0.8909, 0.0321, 0.0158, 0.0167, 0.0213], "severity": [0.9479, 0.0255, 0.0079, 0.0187]}, {"text": "மகன் போன் செய்தான், மனம் நிறைந்தது.", "mood": [0.022, 0.0233, 0.0658, 0.7296, 0.0685, 0.0675, 0.0233], "severity": [0.0814, 0.8267, 0.0365, 0.0554]}, {"text": "um I'm stressed, to be honest", "mood": [0.0067, 0.967, 0.0041, 0.006, 0.0099, 0.0029, 0.0033], "severity": [0.0121, 0.9805, 0.002, 0.0054]}, {"text": "I see no reaosn to go on honestly", "mood": [0.02, 0.0266, 0.0079, 0.0464, 0.6381, 0.2474, 0.0136], "severity": [0.5441, 0.436, 0.0072, 0.0128]}, {"text": "actually i feel my heartbeat skipping and i'm sweating", "mood": [0.006, 0.0131, 0.9324, 0.0071, 0.0169, 0.012, 0.0125], "severity": [0.0108, 0.0095, 0.9688, 0.0108]}, {"text": "um call the doctor please please", "mood": [0.0189, 0.0182, 0.7533, 0.0392, 0.0217, 0.1391, 0.0095], "severity": [0.0085, 0.0377, 0.9429, 0.0109]}, {"text": "Asha, you are very kind, thank you so much again", "mood": [0.004, 0.005, 0.0078, 0.9176, 0.0088, 0.0527, 0.0041], "severity": [0.0071, 0.9765, 0.0044, 0.0119]}, {"text": "DOCTOR, I FEEL VERY SLEEPY TODAY PLEASE", "mood": [0.0023, 0.0033, 0.009, 0.0116, 0.0128, 0.0071, 0.9539], "severity": [0.0078, 0.8978, 0.0114, 0.083]}]