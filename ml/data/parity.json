057]}, {"text": "Nobody visited me this week and it hurts", "mood": [0.3049, 0.0074, 0.0911, 0.1482, 0.3691, 0.035, 0.0444], "severity": [0.0145, 0.832, 0.0107, 0.1428]}, {"text": "I feel like I'm all alone in the world", "mood": [0.0048, 0.0315, 0.0092, 0.0088, 0.9326, 0.0058, 0.0074], "severity": [0.028, 0.8779, 0.0037, 0.0904]}, {"text": "I've been feeling very down lately and I can't eat", "mood": [0.0185, 0.1058, 0.0897, 0.0189, 0.7094, 0.0017, 0.0561], "severity": [0.0284, 0.4999, 0.1257, 0.346]}, {"text": "I keep crying and have no interest in anything or any food", "mood": [0.068, 0.0073, 0.0036, 0.0097, 0.7945, 0.1141, 0.0029], "severity": [0.0152, 0.9702, 0.0004, 0.0143]}, {"text": "What if the scan shows something serious, I can't stop thinking about it", "mood": [0.0033, 0.9628, 0.0137, 0.0027, 0.0036, 0.0134, 0.0005], "severity": [0.2395, 0.5406, 0.187, 0.033]}, {"text": "I am really nervous about the operation next week", "mood": [0.002, 0.9898, 0.0005, 0.0007, 0.0007, 0.0054, 0.0009], "severity": [0.0016, 0.9941, 0.0013, 0.003]}, {"text": "My mind keeps racing with worry tonight", "mood": [0.0195, 0.8013, 0.0652, 0.0581, 0.0191, 0.0166, 0.0202], "severity": [0.1093, 0.4892, 0.0597, 0.3418]}, {"text": "My hands are trembling and I feel jumpy", "mood": [0.0308, 0.5568, 0.0999, 0.1304, 0.0767, 0.0263, 0.0791], "severity": [0.0039, 0.0203, 0.0023, 0.9736]}, {"text": "I feel so drained today, I just want to sleep", "mood": [0.0001, 0.0002, 0.0002, 0.0003, 0.001, 0.0001, 0.998], "severity": [0.1064, 0.4208, 0.0183, 0.4546]}, {"text": "I have no strength left after that walk", "mood": [0.0892, 0.0931, 0.1036, 0.0844, 0.0833, 0.2122, 0.3342], "severity": [0.0682, 0.911, 0.0061, 0.0147]}, {"text": "I feel faint and weak every time I stand up", "mood": [0.0537, 0.0115, 0.0262, 0.0122, 0.0105, 0.0133, 0.8727], "severity": [0.0579, 0.0623, 0.0051, 0.8747]}, {"text": "I hardly slept and now I feel awful and shaky", "mood": [0.0098, 0.0375, 0.0292, 0.1572, 0.0098, 