# Copy this file to .env.local and fill in your own values. .env.local is git-ignored: never commit a real key.

# OpenRouter (https://openrouter.ai/keys) powers the AI route explanations in ClinicCompass.
# The key stays on the dev server: it is added to requests there and is never sent to or stored in the browser.
# Restart `npm run dev` after changing it.
OPENROUTER_API_KEY=
